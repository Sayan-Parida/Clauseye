# Frontend build-time configuration.
#
# Vite inlines VITE_* variables at build time, so these are baked into the bundle.
# There is no runtime env lookup and no way for a visitor to influence them.

# Analyze endpoint. Leave unset to use the production backend.
#
# The value is compiled into the JavaScript bundle and is therefore public. That
# is acceptable here because the endpoint is rate limited and requires no
# credential, but it does mean this is not a place to put a secret. If the
# backend later requires an API key, it must be validated server-side by the
# backend against a browser-supplied hint rather than embedded here.
#
# When running the stack locally with docker compose, use:
#   VITE_ANALYZE_API_URL=http://localhost:8080/analyze
VITE_ANALYZE_API_URL=http://localhost:8080/analyze
